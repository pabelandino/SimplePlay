    "dialog.reset_session_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently remove all tracks, multitracks, sections, markers, selections, and timeline edits. Mixer levels and MIDI mappings in this session will also be cleared. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará de forma permanente todas las pistas, multitracks, secciones, marcadores, selecciones y ediciones de la línea de tiempo. Los niveles del mezclador y las asignaciones MIDI de esta sesión también se borrarán. Esta acción no se puede deshacer."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto removerá permanentemente todas as faixas, multitracks, seções, marcadores, seleções e edições da linha do tempo. Os níveis do mixer e os mapeamentos MIDI desta sessão também serão apagados. Esta ação não pode ser desfeita."
          }
        }
      }
    },
