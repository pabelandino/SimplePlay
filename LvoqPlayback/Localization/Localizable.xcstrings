    "section.creation_hint_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the Sections lane, tap and drag horizontally to create a marker. Tap a marker to delete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el carril de secciones, toca y arrastra en horizontal para crear un marcador. Toca un marcador para eliminarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na faixa de seções, toque e arraste na horizontal para criar um marcador. Toque em um marcador para excluí-lo."
          }
        }
      }
    },
    "section.creation_hint_mac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
