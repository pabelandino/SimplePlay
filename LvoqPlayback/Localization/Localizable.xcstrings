    "dialog.new_project_message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a blank project? You can save your current work first, including tracks, sections, markers, mixer settings, and MIDI mappings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Empezar un proyecto en blanco? Puedes guardar primero tu trabajo actual, incluidas pistas, secciones, marcadores, mezclador y asignaciones MIDI."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Começar um projeto em branco? Você pode salvar primeiro o trabalho atual, incluindo faixas, seções, marcadores, mixer e mapeamentos MIDI."
          }
        }
      }
    },
