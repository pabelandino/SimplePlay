          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En el carril de secciones, arrastra en horizontal para crear un marcador. Toca un marcador para eliminarlo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
