          }
        }
      }
    },
    "section.play_footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While playing, another pad queues a jump at the current section end. Press the same section pad again during playback to repeat it once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la reproducción, otro pad pone en cola un salto al final de la sección actual. Pulsa de nuevo el mismo pad durante la reproducción para repetirla una vez."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante a reprodução, outro pad enfileira um salto no fim da seção atual. Pressione o mesmo pad novamente durante a reprodução para repetir uma vez."
          }
        }
      }
    },
